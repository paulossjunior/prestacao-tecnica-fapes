# Copie para .env e preencha
API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # chave da OpenAI
MODEL=gpt-4o                    # análise (qualidade)
OPENAI_OCR_MODEL=gpt-5.4-nano   # OCR (barato)
PORT=5000

# Login do SIGFAPES (em container use SIGFAPES_USER/SIGFAPES_PASSWORD; USER colide
# com o usuário do SO). Localmente, via .env, USER/PASSWORD/SITE funcionam.
USER=seu.login.sigfapes
PASSWORD=sua_senha_sigfapes
SITE=https://www.sigfapes.es.gov.br

# Login da aplicação (tela de /login). Defina APP_PASSWORD para exigir login
# (vazio = app aberta, sem auth). Troque a senha e gere um secret próprio:
#   openssl rand -hex 32
APP_USER=admin
APP_PASSWORD=troque_esta_senha
APP_SECRET_KEY=gere_com_openssl_rand_hex_32
# Em produção atrás de HTTPS, descomente:
# SESSION_COOKIE_SECURE=1
