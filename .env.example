# Copie para .env e preencha

# --- Forma simples: chave + modelo genéricos ---
# O provedor é deduzido do nome do modelo (gpt-* -> OpenAI, mistral-* -> Mistral).
API_KEY=sua_chave_aqui
MODEL=gpt-4o

# --- Explícito (opcional): vence a dedução acima ---
# LLM_PROVIDER=openai            # openai | mistral
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_OCR_MODEL=              # vazio = usa OPENAI_MODEL
# OPENAI_BASE_URL=               # Azure OpenAI / proxy compatível
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_OCR_MODEL=mistral-ocr-latest

PORT=5000
