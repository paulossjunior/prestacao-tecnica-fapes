# Copie para .env e preencha

# --- Forma simples: chave + modelo genéricos ---
# O provedor é deduzido do nome do modelo (gpt-* -> OpenAI, mistral-* -> Mistral).
API_KEY=sua_chave_aqui
MODEL=gpt-4o

# --- Explícito (opcional): vence a dedução acima ---
# LLM_PROVIDER=openai            # openai | mistral
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_OCR_MODEL=              # vazio = usa OPENAI_MODEL
# Dica de custo (recomendado): OCR num modelo barato + análise no gpt-4o.
# O OCR é ~72% do custo e tolera modelo barato; a análise (parecer/nota)
# precisa de qualidade. Usar modelo barato também na análise derruba a
# qualidade (pareceres uniformes, notas erráticas, aprovações invertidas).
#   OPENAI_MODEL=gpt-4o           # análise: qualidade do parecer
#   OPENAI_OCR_MODEL=gpt-5.4-nano # OCR: barato (~2,7x mais barato no total)
# OPENAI_BASE_URL=               # Azure OpenAI / proxy compatível
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_OCR_MODEL=mistral-ocr-latest

PORT=5000
